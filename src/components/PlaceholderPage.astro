---
// Placeholder home page until I-11, shared by the PT and EN pairs. The only
// claims are the name and the approved title of D-022.
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title="Filipe Oliveira" description={`Filipe Oliveira — ${title}`}>
  <h1>Filipe Oliveira</h1>
  <p class="muted">{title}</p>
</BaseLayout>
