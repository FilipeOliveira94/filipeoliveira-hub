---
// Language switcher (I-06): a button with a globe icon and the current
// language; it opens a menu with both languages, where the other one links to
// the same page in that language (D-003). <details> makes it work without JS;
// the script only adds Esc and click-outside to close it.
import { withBase } from '../lib/paths';
import { UI, alternatePath, type Lang } from '../lib/lang';

interface Props {
  lang: Lang;
  sitePath: string;
}

const { lang, sitePath } = Astro.props;
const items = (['pt-BR', 'en'] as const).map((code) => ({
  code,
  name: UI[code].name,
  href: withBase(code === lang ? sitePath : alternatePath(sitePath)),
  current: code === lang,
}));
---

<details class="lang-switcher">
  <summary>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>
    </svg>
    <span class="visually-hidden">{UI[lang].language}: {UI[lang].name}</span>
    <span aria-hidden="true">{UI[lang].short}</span>
  </summary>
  <ul>
    {
      items.map((item) => (
        <li>
          {item.current ? (
            <span class="current" lang={item.code} aria-current="true">
              {item.name}
            </span>
          ) : (
            <a href={item.href} lang={item.code} hreflang={item.code}>
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</details>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.lang-switcher')) {
    const summary = menu.querySelector('summary');
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .lang-switcher {
    position: relative;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: var(--weight-bold);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .lang-switcher[open] summary {
    background: var(--color-surface);
  }
  ul {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-1));
    z-index: 5;
    min-width: 10rem;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
  }
  li > * {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }
  .current {
    color: var(--color-text-muted);
  }
  .current::after {
    content: ' ✓';
  }
  a {
    color: var(--color-link);
    font-weight: var(--weight-bold);
  }
  a:hover {
    background: var(--color-surface);
  }
</style>
