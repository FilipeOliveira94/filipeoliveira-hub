---
// Brand and component sample (I-05), shared by the PT and EN pages. It shows
// the brand tokens, the type and spacing scales and the base components, in the
// theme the system asks for. The text describes the components only: no
// content claims.
import BaseHead from './BaseHead.astro';
import { withBase } from '../lib/paths';
import { TEXT_PAIRS, contrast, parseTokens } from '../lib/contrast.mjs';
import tokensCss from '../assets/brand/tokens.css?raw';
import logoLight from '../assets/brand/logo/fi-logo-light.svg?url';
import logoDark from '../assets/brand/logo/fi-logo-dark.svg?url';
import markLight from '../assets/brand/logo/fi-mark-light.svg?url';
import markDark from '../assets/brand/logo/fi-mark-dark.svg?url';

interface Props {
  lang: 'pt-BR' | 'en';
}

const { lang } = Astro.props;

const t = {
  'pt-BR': {
    title: 'Marca e componentes — Filipe Oliveira',
    description: 'Amostra da marca e dos componentes base do site.',
    heading: 'Marca e componentes',
    intro:
      'Amostra dos tokens da marca, das escalas de tipo e espaçamento e dos componentes base. O tema claro ou escuro segue a configuração do sistema.',
    logo: 'Logo',
    logoAlt: 'Filipe Oliveira, Engenheiro de Dados & Software',
    markAlt: 'Fi',
    colors: 'Cores',
    role: 'Papel',
    token: 'Token',
    contrastTitle: 'Contraste de texto',
    contrastIntro: 'Razão WCAG de cada par de texto e fundo usado pelo site. O mínimo é 4,5:1.',
    pair: 'Texto sobre fundo',
    light: 'Claro',
    dark: 'Escuro',
    type: 'Tipografia',
    typeSample: 'Dados confiáveis, código simples',
    spacing: 'Espaçamento',
    components: 'Componentes',
    primary: 'Ação principal',
    secondary: 'Ação secundária',
    link: 'Um link no meio do texto',
    paragraph: 'Parágrafo de exemplo em Urbanist 500, com',
    paragraphEnd: 'e texto auxiliar em tom mais suave.',
    mutedText: 'Texto auxiliar em --color-text-muted.',
    cardTitle: 'Card',
    cardBody: 'Superfície para destaques e projetos, com borda e cantos arredondados.',
    tags: ['Tag', 'Python', 'SQL'],
    focus: 'Use Tab para ver o foco visível em cada elemento interativo.',
  },
  en: {
    title: 'Brand and components — Filipe Oliveira',
    description: 'Sample of the brand and the base components of the site.',
    heading: 'Brand and components',
    intro:
      'Sample of the brand tokens, the type and spacing scales and the base components. The light or dark theme follows the system setting.',
    logo: 'Logo',
    logoAlt: 'Filipe Oliveira, Data & Software Engineer',
    markAlt: 'Fi',
    colors: 'Colors',
    role: 'Role',
    token: 'Token',
    contrastTitle: 'Text contrast',
    contrastIntro: 'WCAG ratio of each text and background pair the site uses. The minimum is 4.5:1.',
    pair: 'Text on background',
    light: 'Light',
    dark: 'Dark',
    type: 'Typography',
    typeSample: 'Reliable data, simple code',
    spacing: 'Spacing',
    components: 'Components',
    primary: 'Primary action',
    secondary: 'Secondary action',
    link: 'A link inside the text',
    paragraph: 'Sample paragraph in Urbanist 500, with',
    paragraphEnd: 'and supporting text in a softer tone.',
    mutedText: 'Supporting text in --color-text-muted.',
    cardTitle: 'Card',
    cardBody: 'A surface for highlights and projects, with a border and rounded corners.',
    tags: ['Tag', 'Python', 'SQL'],
    focus: 'Press Tab to see the visible focus on each interactive element.',
  },
}[lang];

const roles = [
  ['--color-bg', '--fi-bg'],
  ['--color-surface', '--fi-c0'],
  ['--color-surface-strong', '--fi-b1'],
  ['--color-border', '--fi-b2'],
  ['--color-text', '--fi-ink'],
  ['--color-text-muted', '--fi-muted'],
  ['--color-accent', '--fi-accent'],
  ['--color-dot', '--fi-dot'],
];

const themes = parseTokens(tokensCss);
const ratios = TEXT_PAIRS.map(([fg, bg]) => ({
  label: `--fi-${fg} / --fi-${bg}`,
  light: contrast(themes.light[fg], themes.light[bg]).toFixed(2),
  dark: contrast(themes.dark[fg], themes.dark[bg]).toFixed(2),
}));

const typeSteps = ['--text-2xl', '--text-xl', '--text-lg', '--text-md', '--text-base', '--text-sm'];
const spaceSteps = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => `--space-${n}`);
const home = lang === 'en' ? '/en/' : '/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={t.title} description={t.description} />
    <style>
      main {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: var(--space-7) var(--space-4) var(--space-9);
      }
      section {
        margin-top: var(--space-8);
      }
      .logos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-6);
      }
      .swatches {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
        gap: var(--space-4);
        padding: 0;
        list-style: none;
      }
      .swatch {
        display: block;
        height: 3.5rem;
        border: var(--border-width) solid var(--color-border);
        border-radius: var(--radius-md);
        margin-bottom: var(--space-2);
      }
      .swatches code {
        display: block;
        font-size: var(--text-sm);
      }
      table {
        border-collapse: collapse;
        width: 100%;
        max-width: 40rem;
      }
      th,
      td {
        text-align: left;
        padding: var(--space-2) var(--space-3);
        border-bottom: var(--border-width) solid var(--color-border);
      }
      td:not(:first-child),
      th:not(:first-child) {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .type-step {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-2) var(--space-5);
        margin-bottom: var(--space-4);
      }
      .type-step code {
        min-width: 8rem;
        color: var(--color-text-muted);
        font-size: var(--text-sm);
      }
      .type-step span {
        font-weight: var(--weight-bold);
        letter-spacing: var(--tracking-tight);
        line-height: var(--leading-tight);
      }
      .space-step {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        margin-bottom: var(--space-2);
      }
      .space-step code {
        min-width: 8rem;
        font-size: var(--text-sm);
      }
      .space-bar {
        height: 1rem;
        background: var(--color-accent);
        border-radius: 2px;
      }
      .row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        margin-bottom: var(--space-5);
      }
      .card {
        max-width: 24rem;
      }
      .table-wrap {
        overflow-x: auto;
      }
    </style>
  </head>
  <body>
    <main id="main">
      <p><a href={withBase(home)}>Filipe Oliveira</a></p>
      <h1>{t.heading}</h1>
      <p class="muted">{t.intro}</p>

      <section aria-labelledby="logo">
        <h2 id="logo">{t.logo}</h2>
        <div class="logos">
          <picture>
            <source srcset={logoDark} media="(prefers-color-scheme: dark)" />
            <img src={logoLight} alt={t.logoAlt} width="308" height="81" />
          </picture>
          <picture>
            <source srcset={markDark} media="(prefers-color-scheme: dark)" />
            <img src={markLight} alt={t.markAlt} width="69" height="81" />
          </picture>
        </div>
      </section>

      <section aria-labelledby="colors">
        <h2 id="colors">{t.colors}</h2>
        <ul class="swatches">
          {
            roles.map(([role, token]) => (
              <li>
                <span class="swatch" style={`background: var(${role})`} />
                <code>{role}</code>
                <code class="muted">{token}</code>
              </li>
            ))
          }
        </ul>

        <h3>{t.contrastTitle}</h3>
        <p class="muted">{t.contrastIntro}</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">{t.pair}</th>
                <th scope="col">{t.light}</th>
                <th scope="col">{t.dark}</th>
              </tr>
            </thead>
            <tbody>
              {
                ratios.map((r) => (
                  <tr>
                    <td>
                      <code>{r.label}</code>
                    </td>
                    <td>{r.light}:1</td>
                    <td>{r.dark}:1</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="type">
        <h2 id="type">{t.type}</h2>
        {
          typeSteps.map((step) => (
            <div class="type-step">
              <code>{step}</code>
              <span style={`font-size: var(${step})`}>{t.typeSample}</span>
            </div>
          ))
        }
        <p>
          {t.paragraph} <a href={withBase(home)}>{t.link}</a>, <strong>Urbanist 700</strong>
          {' '}<span class="muted">{t.paragraphEnd}</span>
        </p>
      </section>

      <section aria-labelledby="spacing">
        <h2 id="spacing">{t.spacing}</h2>
        {
          spaceSteps.map((step) => (
            <div class="space-step">
              <code>{step}</code>
              <span class="space-bar" style={`width: var(${step})`} />
            </div>
          ))
        }
      </section>

      <section aria-labelledby="components">
        <h2 id="components">{t.components}</h2>
        <p class="muted">{t.focus}</p>
        <div class="row">
          <a class="button" href={withBase(home)}>{t.primary}</a>
          <a class="button button--secondary" href={withBase(home)}>{t.secondary}</a>
        </div>
        <div class="row">
          {t.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <article class="card">
          <h3>{t.cardTitle}</h3>
          <p>{t.cardBody}</p>
          <p class="muted">{t.mutedText}</p>
          <div class="row">
            {t.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <a href={withBase(home)}>{t.link}</a>
        </article>
      </section>
    </main>
  </body>
</html>
