---
// Base layout of every page (I-06): skip link, header, main and footer, on the
// I-05 tokens, in light and dark by system setting (D-023).
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { langOf, sitePathOf } from '../lib/lang';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const sitePath = sitePathOf(Astro.url.pathname, import.meta.env.BASE_URL);
const lang = langOf(sitePath);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} sitePath={sitePath} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang).skip}</a>
    <SiteHeader lang={lang} sitePath={sitePath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }
  main:focus {
    outline: none;
  }
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-bold);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
</style>
